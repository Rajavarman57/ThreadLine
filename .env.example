# Neon PostgreSQL connection string (pooled connection for serverless/Next.js)
DATABASE_URL="postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require&pgbouncer=true"

# Neon PostgreSQL direct connection string (unpooled, for migrations/Prisma CLI)
DIRECT_URL="postgresql://user:password@ep-sample.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Auth.js / NextAuth v5 Secret (generate with `npx auth secret` or `openssl rand -base64 32`)
AUTH_SECRET="change-this-to-a-secure-random-32-byte-secret"

# Auth trust host (set to true for Vercel and local preview)
AUTH_TRUST_HOST="true"
